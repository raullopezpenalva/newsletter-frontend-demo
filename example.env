# --- Environment Variables for Newsletter Service ---

# -----------------------------------------------
# --- SPRING APPLICATION CONFIGURATION ---
# -----------------------------------------------

# --- Application Environment Variables ---
SPRING_APPLICATION_NAME=NewsletterService
SPRING_SERVER_PORT=8080

# --- PostgreSQL Database Configuration ---
SPRING_DATASOURCE_URL=jdbc:postgresql://newsletter_postgres:5432/newsletter_db
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin

# --- Spring SMTP Server Configuration ---
SPRING_MAIL_HOST=email_service
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=no-reply@gmail.com

# --- Frontend Base URL ---
SPRING_FRONTEND_BASE_URL=http://localhost/newsletter

# -----------------------------------------------
# --- PostgreSQL CONFIGURATION ---
# -----------------------------------------------

# --- PostgreSQL Environment Variables ---
POSTGRES_DB=newsletter_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin


# -----------------------------------------------
# --- Frontend Configuration ---
# -----------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_OPENAPI_SPEC_URL=/v3/api-docs